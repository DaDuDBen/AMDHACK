# LLM Mode: "claude" | "ollama" | "groq" | "offline"
LLM_MODE=groq

# Required only if LLM_MODE=groq (DEFAULT — free, fast)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Required only if LLM_MODE=ollama (local, offline-capable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=chemistry-mistral-7b

# Required only if LLM_MODE=claude
ANTHROPIC_API_KEY=sk-ant-...

# Server config
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
